# Copy to local-backend.conf and edit for this machine.
# Used by run-local-backend.sh.

# Prefer a non-reasoning (instruct) model. Reasoning models spend most of their
# token budget thinking, which pushes each reply past the point where the turn is
# cancelled and Reachy never answers. See README, "Troubleshooting".
LLM_MODEL="qwen/qwen3.8-27b"
LLM_BASE_URL="http://127.0.0.1:1234/v1"
LLM_API_KEY="lm-studio"

# WS_HOST="127.0.0.1"
# WS_PORT="8765"
# STT="parakeet-tdt"
# TTS="qwen3"

# --- Backend selection ------------------------------------------------------
# responses-api    : LM Studio (implements /v1/responses)
# chat-completions : omlx, mlx_lm.server (no /v1/responses)
#
# omlx is markedly faster at Reachy's real context size (~9k tokens/turn)
# because of its prefix cache -- see README, "Which LLM server".
# LLM_BACKEND="chat-completions"
# LLM_BASE_URL="http://127.0.0.1:8123/v1"
# LLM_MODEL="Qwen3-Coder-Next-MLX-4bit"
