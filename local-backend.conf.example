# Copy to local-backend.conf and edit for this machine.
# Used by run-llm-server.sh and run-local-backend.sh.

# --- LLM server -------------------------------------------------------------
# Thinking models work well here: oMLX honours chat_template_kwargs.
# enable_thinking=false, which run-local-backend.sh sends via
# --responses_api_disable_thinking. Measured on Qwen3.8-27B-4bit:
#   baseline                    7.4s, 315 chars of reasoning
#   enable_thinking=false       1.5s, zero reasoning
#   reasoning_effort=none       4.1s, 239 chars  (wrong lever)
# LM Studio's llama.cpp backend ignores all of these -- see README.
# Default: oMLX. Its prefix cache is worth ~2x over LM Studio at the app's real
# ~9k-token turns, and ~9x over LM Studio's MLX engine, which does not cache.
# Install with ./setup-llm-server.sh, start with ./run-llm-server.sh.
LLM_BACKEND="chat-completions"            # omlx has no /v1/responses
LLM_BASE_URL="http://127.0.0.1:8123/v1"
LLM_MODEL="Qwen3.8-27B-4bit"              # as listed by GET /v1/models
LLM_API_KEY="omlx"

# oMLX server settings (run-llm-server.sh)
# OMLX_MODEL_DIR="$HOME/.lmstudio/models"
# OMLX_PORT="8123"
# OMLX_SSD_CACHE_MAX="20GB"
# OMLX_HOT_CACHE_MAX="8GB"                # absolute size; '20%' is rejected

# --- Alternative: LM Studio -------------------------------------------------
# Workable without installing anything extra, but use a GGUF model: LM Studio's
# llama.cpp engine caches prompts, its MLX engine does not (5.13s vs 1.07s per
# turn at 6.6k context). Also raise the loaded context length above 8192, or it
# refuses the app's ~9k-token prompts with HTTP 400.
# LLM_BACKEND="responses-api"
# LLM_BASE_URL="http://127.0.0.1:1234/v1"
# LLM_MODEL="<a GGUF instruct model>"
# LLM_API_KEY="lm-studio"

# --- Realtime server (run-local-backend.sh) ---------------------------------
# WS_HOST="127.0.0.1"
# WS_PORT="8765"
# STT="parakeet-tdt"
# TTS="qwen3"
