# Copy to .env to run the conversation app against a fully local backend
# instead of the hosted Hugging Face realtime gateway.
#
# Requires speech-to-speech running first (see README, "Fully local backend").
HF_REALTIME_CONNECTION_MODE=local
HF_REALTIME_WS_URL=ws://127.0.0.1:8765/v1/realtime

# Optional: input transcription language (default en)
# REALTIME_TRANSCRIPTION_LANGUAGE=en
