# Copy to proxy.env. Sourced by run-local-backend.sh and prefetch-models.sh.
# Only needed behind a TLS-intercepting corporate proxy. See README,
# "Corporate proxy (TLS interception)".
#
# Two things differ from the obvious setup:
#   1. Hugging Face LFS weights redirect to us.aws.cdn.hf.co, which the default
#      egress proxy refuses (407). proxy-intlho reaches it.
#   2. That proxy re-signs TLS, so Python's certifi bundle rejects it. Point the
#      standard CA env vars at a bundle that includes the corporate roots
#      (generate with ./make-ca-bundle.sh).

export HTTP_PROXY="http://proxy-intlho.wal-mart.com:8080"
export HTTPS_PROXY="$HTTP_PROXY"
export NO_PROXY="localhost,127.0.0.1,::1,.walmart.com,.wal-mart.com"

export REQUESTS_CA_BUNDLE="$PWD/certs/walmart-ca-bundle.pem"
export SSL_CERT_FILE="$REQUESTS_CA_BUNDLE"
export CURL_CA_BUNDLE="$REQUESTS_CA_BUNDLE"

# hf-xet is a separate Rust HTTP stack that honours none of the above.
export HF_HUB_DISABLE_XET=1
